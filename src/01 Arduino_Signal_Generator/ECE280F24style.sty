\newcommand{\pldECE}[1]{\stepcounter{pldECEx}\color{BrickRed}\textbf{Pre-lab Deliverable (\arabic{pldECEx}/\total{pldECEx}): }{#1}\color{black} }
\newcommand{\cpECE}[1]{\stepcounter{cpECEx}\color{OliveGreen}\textbf{Checkpoint (\arabic{cpECEx}/\total{cpECEx}): }{#1}\color{black} }
\newcommand{\disECE}[1]{\stepcounter{disECEx}\color{Plum}\textbf{Discussion (\arabic{disECEx}/\total{disECEx}): }{#1}\color{black} }
\newcommand{\delECE}[1]{\stepcounter{delECEx}\color{Plum}\textbf{Deliverable (\arabic{delECEx}/\total{delECEx}): }{#1}\color{black} }
\newcommand{\IDCCheckECE}[1]{\stepcounter{IDCCheckECEx}\color{PineGreen}\textbf{IDC Checkpoint (\arabic{IDCCheckECEx}/\total{IDCCheckECEx}): }{#1}\color{black} }
\newcommand{\idelECE}[1]{\stepcounter{idelECEx}\color{Mahogany}\textbf{IDC Deliverable (\arabic{idelECEx}/\total{idelECEx}): }{#1}\color{black} }

